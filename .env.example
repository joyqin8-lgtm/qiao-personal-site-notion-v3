# Server-only. Never prefix these with NEXT_PUBLIC_.
NOTION_TOKEN=ntn_your_internal_integration_secret
NOTION_DATABASE_ID=b68ae49015744ad49043f202c85a90d2
# Optional but recommended for Notion API 2025-09-03. If omitted, the server
# resolves the first data source from NOTION_DATABASE_ID at runtime.
NOTION_DATA_SOURCE_ID=
EDITOR_PASSWORD=choose-a-strong-editor-password
# Generate with: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters
